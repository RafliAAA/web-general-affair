datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssetStatus {
  Tersedia
  Dipinjam
  Diperbaiki
  Diserahkan
  Dihapus
}

enum AssetCondition {
  Baik
  Cukup
  Rusak
}

enum ProcurementStatus {
  Menunggu
  Disetujui
  Ditolak
}

enum RecipientType {
  Personal
  Divisi
}

enum HandoverStatus {
  Aktif       
  Dikembalikan 
}

enum BorrowStatus {
  Menunggu
  Disetujui
  Ditolak
  Dibatalkan
  Dikembalikan
}

enum MaintenanceStatus {
  MenungguVerifikasi    
  MenungguDikerjakan    
  SedangDikerjakan      
  Selesai                
  Ditolak               
  TidakDapatDiperbaiki  
}

enum DisposalMethod {
  Jual
  Hibah
  Kirim
}

enum RoomStatus {
  Tersedia
  TidakTersedia
}

enum BookingStatus {
  Menunggu
  Disetujui
  Ditolak
  Selesai
}

enum Role {
  USER
  ADMIN
  IT
}

enum NotificationType {
  BORROW_REQUEST
  BORROW_STATUS
  RETURN_REQUEST
  MAINTENANCE_REPORT
  MAINTENANCE_STATUS
  ROOM_BOOKING_REQUEST
  ROOM_BOOKING_STATUS
  PROCUREMENT_STATUS
  HANDOVER
  SYSTEM
}


model User {
  user_id   String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrows  Borrow[] 
  approvedBorrows Borrow[] @relation("BorrowApprover")
  approvedReturns Return[] @relation("ReturnApprover") 
  reportedMaintenances Maintenance[] @relation("MaintenanceReporter")
  verifiedMaintenances Maintenance[] @relation("MaintenanceVerifier")
  handledMaintenances  Maintenance[] @relation("MaintenanceHandler")

  receivedHandovers Handover[] @relation("HandoverReceiver")
  createdHandovers  Handover[] @relation("HandoverCreator")
  returnedHandovers Handover[] @relation("HandoverReturner")
  roomBookings RoomBooking[] @relation("BookingUser")
  reviewedBookings RoomBooking[] @relation("BookingReviewer")
  notifications Notification[]

  profile Profile?
}

model Profile {
  profile_id String   @id @default(uuid())
  entity_id     String?  
  directorate_id String?
  user_id    String   @unique
  name       String?
  photo      String? 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  entity      Entity?     @relation(fields: [entity_id], references: [entity_id])
  directorate Directorate? @relation(fields: [directorate_id], references: [directorate_id])
}

model Entity {
  entity_id    String         @id @default(uuid())
  entity_name  String         @unique
  
  directorates Directorate[]
  handovers    Handover[]
  profiles     Profile[]      
}


model Directorate {
  directorate_id   String   @id @default(uuid())
  directorate_name String   @unique
  entity_id        String

  entity    Entity   @relation(fields: [entity_id], references: [entity_id], onDelete: Cascade)
  handovers Handover[]
  borrows   Borrow[]
  profiles  Profile[] 
}


model Asset {
  asset_id      String   @id @default(uuid())
  procurement_item_id String?
  asset_code    String   @unique
  serial_number String?   @unique
  asset_name    String
  asset_category    AssetCategory? @relation(fields: [asset_category_id], references: [asset_category_id])
  asset_category_id String?
  purchase_date DateTime
  warranty_date DateTime?
  photo         String?
  status        AssetStatus   @default(Tersedia)
  condition     AssetCondition @default(Baik)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?


  procurementItem ProcurementItem? @relation(fields: [procurement_item_id], references: [procurement_item_id])
  handoverItems HandoverItem[] 
  borrow Borrow[]
  disposal DisposalItem[]
  maintenances Maintenance[]
  @@index([status])
}

model AssetCategory {
  asset_category_id String @id @default(uuid())
  category_name     String @unique
  category_code     String @unique

  assets Asset[]
  procurementItems ProcurementItem[] 
}

model Project {
  project_id   String @id @default(uuid())
  project_name String
  start_date   DateTime
  end_date     DateTime
  status       String @default("ongoing")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

}

model Procurement {
  procurement_id  String            @id @default(uuid())
  pr_number       String            @unique
  pr_date         DateTime
  due_date        DateTime
  end_user        String
  remarks         String?
  status          ProcurementStatus            @default(Menunggu)

  actualization_id String? @unique
 actualization    ActualizationForm? @relation(fields: [actualization_id], references: [actualization_id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           ProcurementItem[]
}

model ProcurementItem {
  procurement_item_id              String      @id @default(uuid())
  procurement_id  String
  part_number     String
  description     String
  quantity        Int
  quantity_approved Int
  unit_of_measure String
  asset_category_id                String?
  asset_category                   AssetCategory? @relation(fields: [asset_category_id], references: [asset_category_id])

  procurement     Procurement @relation(fields: [procurement_id], references: [procurement_id], onDelete: Cascade)
  assets        Asset[] 
}

model Handover {
  handover_id   String         @id @default(uuid())
  user_id       String        
  entity_id      String         
  directorate_id String 
  created_by    String       
  recipient_type      RecipientType @default(Personal)  
  handover_date DateTime
  status        HandoverStatus @default(Aktif)

  returned_at   DateTime?
  return_notes  String?
  returned_by   String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items    HandoverItem[]
  receiver User  @relation("HandoverReceiver", fields: [user_id], references: [user_id])
  creator  User  @relation("HandoverCreator", fields: [created_by], references: [user_id])
  returner User? @relation("HandoverReturner", fields: [returned_by], references: [user_id])
   entity       Entity       @relation(fields: [entity_id], references: [entity_id])
  directorate  Directorate  @relation(fields: [directorate_id], references: [directorate_id])

  @@index([user_id])
  @@index([status])
}

model HandoverItem {
  handover_item_id String @id @default(uuid())
  handover_id      String
  asset_id         String
  notes            String?

  handover Handover @relation(fields: [handover_id], references: [handover_id], onDelete: Cascade)
  asset    Asset    @relation(fields: [asset_id], references: [asset_id])

  @@unique([handover_id, asset_id])
}

model Borrow {
  borrow_id           String   @id @default(uuid())
  user_id             String
  asset_id            String
  borrow_reason       String
  borrow_date         DateTime
  recipient_type      RecipientType @default(Personal)
  expected_return_date DateTime?
  directorate_id      String?
  status              BorrowStatus  @default(Menunggu)
  approved_by         String?
  createdAt           DateTime @default(now())          

  user     User     @relation(fields: [user_id], references: [user_id])
  asset    Asset    @relation(fields: [asset_id], references: [asset_id])
  directorate         Directorate? @relation(fields: [directorate_id], references: [directorate_id]) 
  approver User?    @relation("BorrowApprover", fields: [approved_by], references: [user_id])
  returns  Return[]
}

model Return {
  return_id   String   @id @default(uuid())
  borrow_id   String   @unique
  return_condition   String
  notes       String?
  approved_by String?
  return_date DateTime @default(now())
  createdAt   DateTime @default(now())

  borrow   Borrow @relation(fields: [borrow_id], references: [borrow_id])
  approver User?  @relation("ReturnApprover", fields: [approved_by], references: [user_id])

  @@index([borrow_id])
}

model Maintenance {
  maintenance_id   String            @id @default(uuid())
  asset_id         String
  reported_by      String
  description      String

  status           MaintenanceStatus @default(MenungguVerifikasi)

  verified_by      String?
  rejection_reason String?
  verified_at      DateTime?

  taken_by         String?
  taken_at         DateTime?
  resolution_notes String?
  completed_at     DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  asset         Asset              @relation(fields: [asset_id], references: [asset_id])
  reporter      User               @relation("MaintenanceReporter", fields: [reported_by], references: [user_id])
  verifier      User?              @relation("MaintenanceVerifier", fields: [verified_by], references: [user_id])
  handler       User?              @relation("MaintenanceHandler", fields: [taken_by], references: [user_id])
  actualization ActualizationForm?

  @@index([status])
  @@index([asset_id])
}

model ActualizationForm {
  actualization_id String   @id @default(uuid())
  maintenance_id    String   @unique
  form_number       String   @unique

  user_name         String
  form_date         DateTime
  duration_minutes  Int

  description       String
  issue             String
  handling          String
  recommendation    String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  maintenance Maintenance @relation(fields: [maintenance_id], references: [maintenance_id])
  procurement     Procurement? 

  @@index([maintenance_id])
}


model Disposal {
  disposal_id    String @id @default(uuid())

  memo_number    String @unique
  memo_date      DateTime

  to             String
  from           String
  cc             String
  subject        String
  description    String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          DisposalItem[]
}

model DisposalItem {
  disposal_item_id String @id @default(uuid())
  disposal_id      String
  asset_id         String

  notes            String?
  method           DisposalMethod


  disposal Disposal @relation(fields: [disposal_id],references: [disposal_id],onDelete: Cascade)
  asset    Asset    @relation(fields: [asset_id], references: [asset_id])


  @@unique([disposal_id, asset_id])
}

model Room {
  room_id    String     @id @default(uuid())
  name       String
  capacity   Int
  location   String
  status     RoomStatus @default(Tersedia)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

   facilities RoomFacility[]
  bookings RoomBooking[]

  
}

model RoomFacility {
  facility_id String @id @default(uuid())
  room_id     String
  name        String

  room Room @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  
  
}

model RoomBooking {
  booking_id   String        @id @default(uuid())
  room_id      String
  user_id      String
  reviewed_by  String?
  purpose      String
  date         DateTime
  start_time   String        
  end_time     String        
  status       BookingStatus @default(Menunggu)
  reject_notes String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  room     Room  @relation(fields: [room_id], references: [room_id])
  user     User  @relation(fields: [user_id], references: [user_id], name: "BookingUser")
  reviewer User? @relation(fields: [reviewed_by], references: [user_id], name: "BookingReviewer")
}

model Notification {
  notification_id String           @id @default(uuid())
  user_id         String           // User penerima notifikasi
  title           String
  message         String
  type            NotificationType @default(SYSTEM)
  link            String?          // URL tujuan saat notifikasi diklik (misal: /borrows/123)
  is_read         Boolean          @default(false)
  createdAt       DateTime         @default(now())

  // Relasi ke User
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, is_read]) // Index untuk mempercepat query notifikasi yang belum dibaca
}

